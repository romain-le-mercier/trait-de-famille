# ---------------------------------------------------------------------------
# Trait de Famille — variables d'environnement
# Copie ce fichier en .env.local (ou .env) et remplis ce dont tu as besoin.
# Une clé de moteur de rendu est indispensable. Le paiement, lui, peut rester
# vide : il passe alors en "mode démo" (crédits accordés localement, signalé).
# ---------------------------------------------------------------------------

# URL publique du site (utilisée pour les redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Comptes (connexion Google) -------------------------------------------
# Console Google Cloud → Identifiants → ID client OAuth (application Web).
# URI de redirection autorisée à déclarer :
#   http://localhost:3000/api/auth/callback/google
# (et l'équivalent sur ton domaine en production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret de signature des sessions : `openssl rand -base64 32`
AUTH_SECRET=

# --- Stripe (paiement réel) ------------------------------------------------
# Clé secrète en mode test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret du webhook : `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# --- Moteur de rendu (REQUIS) ---------------------------------------------
# Sans l'un de ces deux blocs, l'app n'a pas de moteur de génération.
# Replicate est prioritaire s'il est configuré.

# Replicate — modèle de line-art / edge detection
REPLICATE_API_TOKEN=
REPLICATE_MODEL=

# Google Gemini — génération d'image
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image-preview
